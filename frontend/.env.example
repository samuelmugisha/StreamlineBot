# URL of the AdminIE FastAPI backend
VITE_API_URL=http://localhost:8000

# Must match API_KEY in the backend .env
# PRODUCTION NOTE: this value is embedded in the browser bundle.
# For production, proxy API calls through the grant management system's
# own backend so this key never reaches the browser.
VITE_API_KEY=your-secret-key-here

# Optional error tracking (Sentry). Leave blank to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
