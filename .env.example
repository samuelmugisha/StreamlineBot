# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key the frontend sends in the X-API-Key header.
# Leave blank to disable auth in development.
# PRODUCTION NOTE: the frontend bundle exposes VITE_API_KEY to the browser.
# For production, have the grant management system backend proxy requests to
# this API instead of calling it directly from the browser — that way the
# API key stays server-side only.
API_KEY=your-secret-key-here

# Comma-separated allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,https://your-grants-system.com

# Rate limit per IP on /escalate and /feedback, and the limiter's default
# (requests per minute).
RATE_LIMIT=20/minute

# Stricter per-IP rate limit on /chat — the most expensive endpoint
# (retrieval + generation + sentiment scoring = multiple OpenAI calls).
CHAT_RATE_LIMIT=8/minute

# Per-conversation limit on /chat, independent of IP — catches abuse that
# rotates IPs but reuses one session (requests per 60 seconds).
SESSION_CHAT_LIMIT=10

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Docker build (used by docker-compose when building the widget image) ──────
# Set to the public URL of your backend API for production deployments.
VITE_API_URL=http://localhost:8000

# ─── LangSmith (monitoring) ───────────────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=Adminiebot
LANGCHAIN_PROJECT=Adminiebot
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Google Docs sync ──────────────────────────────────────────────────────────
GOOGLE_DOC_ID=your-google-doc-id
# Local dev: path to the downloaded service account key file.
GOOGLE_CREDENTIALS_FILE=backend/credentials/google_service_account.json
# Production (e.g. App Platform): paste the same key file's raw JSON contents
# here instead, as a secret — the file itself is gitignored and won't exist
# inside a container build. Takes priority over GOOGLE_CREDENTIALS_FILE if set.
GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}
GDOC_SYNC_INTERVAL_MINUTES=30

# ─── Supabase (adminie-chatbot project) ───────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
# Use the service_role key — it is never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Smart Agent Handoff (escalation emails) ──────────────────────────────────
# console = log escalation emails instead of sending them (default — use until
#           AdminIE provides SMTP credentials).
# smtp    = send escalation emails via the SMTP server configured below.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@adminie.com
SMTP_PASSWORD=your-app-password
# Where escalated conversations are sent.
ESCALATION_EMAIL_TO=success@adminie.com

# ─── Sentiment Analysis ────────────────────────────────────────────────────────
# Frustration score (1-5, scored per user message) at or above this value
# automatically triggers a handoff.
SENTIMENT_ESCALATION_THRESHOLD=4
# Number of consecutive "I don't have enough information" replies before
# automatically triggering a handoff.
NO_ANSWER_STREAK_THRESHOLD=2

# ─── Feedback ───────────────────────────────────────────────────────────────
# "Was this helpful?" star rating (1-5) at or below this value automatically
# triggers a handoff to a human.
LOW_RATING_ESCALATION_THRESHOLD=3
