# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key the frontend sends in the X-API-Key header.
# Leave blank to disable auth in development.
API_KEY=your-secret-key-here

# Comma-separated allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,https://your-streamline-domain.com

# Rate limit per IP on /escalate and /feedback (requests per minute).
RATE_LIMIT=20/minute

# Stricter per-IP rate limit on /chat (requests per minute).
CHAT_RATE_LIMIT=8/minute

# Per-conversation limit on /chat, independent of IP (requests per 60 seconds).
SESSION_CHAT_LIMIT=10

# ─── Google AI (Gemini) ───────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-2.0-flash
STREAMLINE_OCR_MODEL=gemini-2.0-flash

# ─── Docker build ─────────────────────────────────────────────────────────────
# Public URL of your backend API for production deployments.
VITE_API_URL=http://localhost:8000

# ─── LangSmith (monitoring) ───────────────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=Streamline_chatbot
LANGCHAIN_PROJECT=Streamline_chatbot
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Google Drive ingestion ───────────────────────────────────────────────────
GDRIVE_FOLDER_ID=your-google-drive-folder-id
# Local dev: path to the downloaded service account key file.
GOOGLE_CREDENTIALS_FILE=backend/credentials/google_service_account.json
# Production: paste the service account key JSON contents here as a secret.
GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# ─── Supabase (Streamline project) ────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
# Use the service_role key — it is never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Escalation emails ────────────────────────────────────────────────────────
# console = log escalation emails instead of sending them (default).
# smtp    = send escalation emails via the SMTP server configured below.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@streamlinehealth.org
SMTP_PASSWORD=your-app-password
ESCALATION_EMAIL_TO=support@streamlinehealth.org

# ─── Branding ─────────────────────────────────────────────────────────────────
COMPANY_NAME=Streamline

# ─── Sentiment Analysis ───────────────────────────────────────────────────────
SENTIMENT_ESCALATION_THRESHOLD=4
NO_ANSWER_STREAK_THRESHOLD=2

# ─── Feedback ─────────────────────────────────────────────────────────────────
LOW_RATING_ESCALATION_THRESHOLD=3
